# clangd configuration for SDAR
#
# compile_commands.json already carries the per-method g-function macro
# (AR_G_FUNC_BLOGH / MAX_POT / ADD_INNER_POT) on the ar.cxx translation
# units, but clangd may associate a header such as
# src/AR/symplectic_integrator.h with a TU that does not define any
# g-function method (e.g. the hermite.cxx entries), leaving the AR_G_FUNC
# code paths inactive in the index.
#
# To match the latest sample/AR/Makefile g-function builds, force the flag
# on for every TU. Swap BTLOGH for BLOGH / NORM_BLOGH / MUL_ALL_POT /
# MAX_POT / ADD_INNER_POT to index a different method (only one per build).
CompileFlags:
  Add:
    - "-DAR_G_FUNC_BTLOGH"
